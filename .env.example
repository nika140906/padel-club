# Copy this file to .env and replace every value:  cp .env.example .env
# .env is ignored by Git. Never commit real values.
#
# Make each password with:   echo "Pw1-$(openssl rand -hex 16)"
# SQL Server wants upper case, lower case, a digit and a symbol. Keep to
# letters, digits and "-", so the password is also safe inside DATABASE_URL.
MSSQL_SA_PASSWORD=replace-me
BOOKINGS_DB_PASSWORD=replace-me
LADDER_DB_PASSWORD=replace-me

# Signs login tokens; both services get the same value.
# Make it with:   openssl rand -hex 32
TOKEN_SECRET=replace-me
